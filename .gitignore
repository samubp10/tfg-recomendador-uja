# Entornos virtuales
.venv/
venv/
env/

# Caché de Python
__pycache__/
*.py[cod]

# Empaquetado
*.egg-info/
build/
dist/

# Pruebas y cobertura
.pytest_cache/
.coverage
htmlcov/

# Datos generados (no se versionan)
data/

# Editores e IDE
.vscode/
.idea/
graphify-out/

# Sistema operativo
.DS_Store

# LaTeX (archivos auxiliares de compilación)
*.aux
*.log
*.toc
*.lof
*.lot
*.lol
*.out
*.bbl
*.blg
*.fls
*.fdb_latexmk
*.synctex.gz
# El fichero que synctex deja a medias mientras compila; si el editor recompila
# a menudo, aparece y desaparece solo y ensucia el estado del repositorio.
*.synctex(busy)
*.synctex
*.run.xml
*.bcf

# PDF compilado de la memoria (artefacto de build; se regenera con pdflatex)
memoria/main.pdf

# README que exporta Overleaf junto a la plantilla; el README real del
# proyecto es el de la raíz del repo, no el de memoria/
memoria/README.md